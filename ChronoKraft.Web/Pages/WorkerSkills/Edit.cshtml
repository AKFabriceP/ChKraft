                    <input class="form-check-input" asp-for="WorkerSkill.IsPrimary" /> @Html.DisplayNameFor(model => model.WorkerSkill.IsPrimary)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="WorkerSkill.Active" /> @Html.DisplayNameFor(model => model.WorkerSkill.Active)
