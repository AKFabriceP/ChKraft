@page
@model ChronoKraft.Web.Pages_WorkerSkills.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>WorkerSkill</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="WorkerSkill.Id" />
            <div class="form-group">
                <label asp-for="WorkerSkill.WorkerId" class="control-label"></label>
                <select asp-for="WorkerSkill.WorkerId" class="form-control" asp-items="ViewBag.WorkerId" ></select>
                <span asp-validation-for="WorkerSkill.WorkerId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WorkerSkill.ResourceTypeId" class="control-label"></label>
                <input asp-for="WorkerSkill.ResourceTypeId" class="form-control" />
                <span asp-validation-for="WorkerSkill.ResourceTypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WorkerSkill.HourlyRate" class="control-label"></label>
                <input asp-for="WorkerSkill.HourlyRate" class="form-control" />
