@page
@model ChronoKraft.Web.Pages_WorkerSkills.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.WorkerSkill[0].ResourceTypeId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkerSkill[0].HourlyRate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkerSkill[0].Certifications)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkerSkill[0].IsPrimary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkerSkill[0].Active)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkerSkill[0].CreatedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.WorkerSkill) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ResourceTypeId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HourlyRate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Certifications)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsPrimary)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Active)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
