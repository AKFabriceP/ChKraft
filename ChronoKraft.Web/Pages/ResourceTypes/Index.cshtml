@page
@model ChronoKraft.Web.Pages_ResourceTypes.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ResourceType[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ResourceType[0].ResourceCategory)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ResourceType[0].Trade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ResourceType[0].DefaultBillingUnit)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ResourceType[0].SuggestedRateMin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ResourceType[0].SuggestedRateMax)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ResourceType[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ResourceType[0].StandardAttributes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ResourceType[0].Active)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ResourceType[0].CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ResourceType[0].UpdatedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ResourceType) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ResourceCategory)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Trade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DefaultBillingUnit)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SuggestedRateMin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SuggestedRateMax)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StandardAttributes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Active)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
