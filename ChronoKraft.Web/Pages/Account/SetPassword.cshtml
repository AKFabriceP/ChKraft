@* ChronoKraft.Web/Pages/Account/SetPassword.cshtml *@
@page
@model ChronoKraft.Web.Pages.Account.SetPasswordModel

<h2>Define your password</h2>

<form method="post" asp-route-userId="@Request.Query["userId"]" asp-route-token="@Request.Query["token"]">
    <div class="mb-3">
        <label>New password</label>
        <input asp-for="NewPassword" type="password" class="form-control" required />
    </div>
    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" asp-validation-summary="All"></div>
    }
    <button type="submit" class="btn btn-primary">Define your password</button>
</form>