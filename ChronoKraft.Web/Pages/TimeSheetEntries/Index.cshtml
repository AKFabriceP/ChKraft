@page
@model ChronoKraft.Web.Pages_TimeSheetEntries.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TimeSheetEntry[0].WorkerSkill)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TimeSheetEntry[0].TaskId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TimeSheetEntry[0].WorkDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TimeSheetEntry[0].Hours)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TimeSheetEntry[0].Notes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TimeSheetEntry[0].CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TimeSheetEntry[0].UpdatedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.TimeSheetEntry) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.WorkerSkill.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TaskId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WorkDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Hours)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Notes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
