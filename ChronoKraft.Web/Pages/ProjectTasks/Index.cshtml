@page
@model ChronoKraft.Web.Pages_ProjectTasks.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ProjectTask[0].Project)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectTask[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectTask[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectTask[0].RequiredTrade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectTask[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectTask[0].Order)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectTask[0].Attributes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectTask[0].CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectTask[0].UpdatedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ProjectTask) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Project.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RequiredTrade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Order)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Attributes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
