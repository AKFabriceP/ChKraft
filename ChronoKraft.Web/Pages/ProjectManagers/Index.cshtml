@page
@model ChronoKraft.Web.Pages_ProjectManagers.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ProjectManager[0].UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectManager[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectManager[0].Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectManager[0].CrossProjectAccessLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectManager[0].CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProjectManager[0].UpdatedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ProjectManager) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UserId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CrossProjectAccessLevel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                <a asp-page="./CreateAccount" asp-route-projectManagerId="@item.Id">Create Account</a>
            </td>
        </tr>
}
    </tbody>
</table>
